# Copy to .env and adjust. .env is not committed.
# Database (libpq standard variables; values as in the package README)
PGHOST=localhost
PGPORT=5432
PGDATABASE=statistik
PGUSER=statistik
PGPASSWORD=statistik

# Agent for "Fragen" (language model). Never commit real keys; restart `statagent web` after changes.
# Provider detected from the key (sk-ant- = Anthropic, AIza = Gemini, sk- = OpenAI); AGENT_PROVIDER overrides:
# openai | anthropic | azure | gemini | compatible
AGENT_API_KEY=
AGENT_PROVIDER=
# Model / deployment name (Anthropic default: claude-sonnet-5-5)
AGENT_MODEL=
# azure: endpoint URL · compatible: base URL of an OpenAI-compatible server
AGENT_BASE_URL=
# azure only
AGENT_API_VERSION=

# Named persons offered at login in the web UI (comma-separated; approvals need a real name, T7)
STATAGENT_USERS=

# Name logged for questions in „Fragen“ when nobody is logged in (answer log only; approvals need a login)
STATAGENT_FRAGEN_PERSON=
